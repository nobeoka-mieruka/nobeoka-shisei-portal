# scripts/sync-council-data.mjs / scripts/run-archive-crawler.mjs の実行状態
# （5日ごと自動巡回の前回正常実行日時等）。GitHub Actions側ではactions/cacheで保持し、Gitへはコミットしない。
scripts/_sync-state.json
scripts/_archive-crawler-sync-state.json

# scripts/auto-update/{finance,population}/update-*.mjs のクロス実行ハッシュ比較用ローカル状態
