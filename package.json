{
  "name": "nobeoka-gikai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-photo-dimensions.mjs && node scripts/generate-site-update.mjs && node scripts/generate-council-documents.mjs && node scripts/generate-search-index.mjs && vite",
    "validate:data": "node scripts/validate-data.mjs",
    "generate:site-update": "node scripts/generate-site-update.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:robots": "node scripts/generate-robots.mjs",
    "generate:search": "node scripts/generate-search-index.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:photo-dimensions": "node scripts/generate-photo-dimensions.mjs",
    "generate:council-documents": "node scripts/generate-council-documents.mjs",
    "fetch:council-documents": "node scripts/fetch-nobeoka-council-documents.mjs",
    "extract:council-data": "node scripts/extract-council-pdf-data.mjs",
    "generate:bill-summaries": "node scripts/generate-bill-summaries.mjs",
    "generate:session-summaries": "node scripts/generate-session-summaries.mjs",
    "generate:speech-summary-scaffold": "node scripts/generate-speech-summary-scaffold.mjs",
    "fetch:council-minutes": "node scripts/fetch-nobeoka-minutes.mjs",
    "council:approve": "node scripts/approve-council-data.mjs",
    "council:reject": "node scripts/reject-council-data.mjs",
    "speeches:list-pending": "node scripts/review-speech-summaries.mjs --list-pending",
    "speeches:approve": "node scripts/review-speech-summaries.mjs --approve",
    "speeches:reject": "node scripts/review-speech-summaries.mjs --reject",
    "suggest:bill-relations": "node scripts/suggest-bill-relations.mjs",
    "update:council-documents": "npm run fetch:council-documents && npm run extract:council-data && npm run generate:bill-summaries && npm run generate:council-documents && npm run generate:session-summaries && npm run generate:speech-summary-scaffold && npm run validate:data",
    "import:members": "node scripts/import-members.mjs",
    "typecheck": "tsc -b",
    "prerender": "node scripts/prerender.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "build": "node scripts/generate-photo-dimensions.mjs && node scripts/generate-site-update.mjs && node scripts/generate-council-documents.mjs && node scripts/generate-speech-summary-scaffold.mjs && node scripts/validate-data.mjs && node scripts/generate-search-index.mjs && node scripts/generate-robots.mjs && node scripts/generate-sitemap.mjs && tsc -b && vite build && npm run prerender && npm run validate:seo",
    "lint": "oxlint",
    "check": "npm run validate:data && npm run typecheck && npm run lint && npm run build",
    "release:check": "npm run build && node scripts/release-check.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "xlsx": "^0.18.5"
  }
}
